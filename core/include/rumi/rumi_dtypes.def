/* Rumi sample types. Every row has an exact CPU DLPack representation that
 * PyTorch imports without changing the dtype. NUMPY is NULL when NumPy has no
 * scalar for the type. Existing file encodings are never reused. */

/*         CODE ENUM              NAME                 SF BITS STORE COMP DLCODE                 DLBITS LANES NUMPY */
RUMI_DTYPE(  1, UINT8,            "uint8",               1,   8,  1, 1, kDLUInt,                  8, 1, "uint8" )
RUMI_DTYPE(  2, INT8,             "int8",                2,   8,  1, 1, kDLInt,                   8, 1, "int8" )
RUMI_DTYPE(  3, UINT16,           "uint16",              1,  16,  2, 2, kDLUInt,                 16, 1, "uint16" )
RUMI_DTYPE(  4, INT16,            "int16",               2,  16,  2, 2, kDLInt,                  16, 1, "int16" )
RUMI_DTYPE(  5, UINT32,           "uint32",              1,  32,  4, 4, kDLUInt,                 32, 1, "uint32" )
RUMI_DTYPE(  6, INT32,            "int32",               2,  32,  4, 4, kDLInt,                  32, 1, "int32" )
RUMI_DTYPE(  7, UINT64,           "uint64",              1,  64,  8, 8, kDLUInt,                 64, 1, "uint64" )
RUMI_DTYPE(  8, INT64,            "int64",               2,  64,  8, 8, kDLInt,                  64, 1, "int64" )
RUMI_DTYPE(  9, FLOAT16,          "float16",             3,  16,  2, 2, kDLFloat,                16, 1, "float16" )
RUMI_DTYPE( 10, FLOAT32,          "float32",             3,  32,  4, 4, kDLFloat,                32, 1, "float32" )
RUMI_DTYPE( 11, FLOAT64,          "float64",             3,  64,  8, 8, kDLFloat,                64, 1, "float64" )
RUMI_DTYPE( 14, COMPLEX32,        "complex32",           6,  32,  4, 2, kDLComplex,              32, 1, NULL )
RUMI_DTYPE( 15, COMPLEX64,        "complex64",           6,  64,  8, 4, kDLComplex,              64, 1, "complex64" )
RUMI_DTYPE( 16, COMPLEX128,       "complex128",          6, 128, 16, 8, kDLComplex,             128, 1, "complex128" )
RUMI_DTYPE( 17, FLOAT8_E4M3FN,    "float8_e4m3fn",     100,   8,  1, 1, kDLFloat8_e4m3fn,         8, 1, NULL )
RUMI_DTYPE( 18, FLOAT8_E5M2,      "float8_e5m2",       101,   8,  1, 1, kDLFloat8_e5m2,           8, 1, NULL )
RUMI_DTYPE( 19, BFLOAT16,         "bfloat16",          102,  16,  2, 2, kDLBfloat,                16, 1, NULL )
RUMI_DTYPE( 24, BOOL,             "bool",                1,   1,  1, 1, kDLBool,                    8, 1, "bool_" )
RUMI_DTYPE( 25, FLOAT8_E8M0FNU,   "float8_e8m0fnu",   103,   8,  1, 1, kDLFloat8_e8m0fnu,         8, 1, NULL )
RUMI_DTYPE( 29, FLOAT8_E4M3FNUZ,  "float8_e4m3fnuz",  107,   8,  1, 1, kDLFloat8_e4m3fnuz,        8, 1, NULL )
RUMI_DTYPE( 30, FLOAT8_E5M2FNUZ,  "float8_e5m2fnuz",  108,   8,  1, 1, kDLFloat8_e5m2fnuz,        8, 1, NULL )
